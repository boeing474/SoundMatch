<?xml version="1.0" encoding="utf-8"?>
<!--
    Globo espelhado (disco ball) em Vector Drawable.
    Na MainActivity ele gira em loop com ObjectAnimator.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="160dp"
    android:height="160dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Esfera com brilho radial (centro claro, bordas escuras) -->
    <path android:pathData="M60,12 A48,48 0 1,1 59.99,12 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="46"
                android:centerY="44"
                android:gradientRadius="62">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.45" android:color="#FFB8A9D9" />
                <item android:offset="1" android:color="#FF3A2D5C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Alguns "espelhinhos" refletindo as cores neon -->
    <path android:fillColor="#CCFF2A6D" android:pathData="M62,30 H76 V43 H62 Z" />
    <path android:fillColor="#CC05D9E8" android:pathData="M30,62 H44 V75 H30 Z" />
    <path android:fillColor="#CCF9C80E" android:pathData="M76,62 H90 V75 H76 Z" />
    <path android:fillColor="#9905D9E8" android:pathData="M46,78 H60 V91 H46 Z" />
    <path android:fillColor="#99FF2A6D" android:pathData="M44,30 H58 V43 H44 Z" />

    <!-- Grade de espelhos: meridianos (verticais) -->
    <path
        android:strokeColor="#FF2A1F45"
        android:strokeWidth="1.5"
        android:pathData="M60,12 L60,108 M60,12 A16,48 0 1,1 60,108 A16,48 0 1,1 60,12 M60,12 A34,48 0 1,1 60,108 A34,48 0 1,1 60,12" />

    <!-- Grade de espelhos: paralelos (horizontais) -->
    <path
        android:strokeColor="#FF2A1F45"
        android:strokeWidth="1.5"
        android:pathData="M12,60 H108 M14.75,44 H105.25 M14.75,76 H105.25 M24.22,28 H95.78 M24.22,92 H95.78" />

    <!-- Contorno neon -->
    <path
        android:strokeColor="#FFFF2A6D"
        android:strokeWidth="1.5"
        android:pathData="M60,12 A48,48 0 1,1 59.99,12 Z" />

    <!-- Brilhos (estrelas de 4 pontas) -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M100,8 L102,16 L110,18 L102,20 L100,28 L98,20 L90,18 L98,16 Z" />
    <path android:fillColor="#FF05D9E8" android:pathData="M14,92 L15.5,98 L21.5,99.5 L15.5,101 L14,107 L12.5,101 L6.5,99.5 L12.5,98 Z" />
    <path android:fillColor="#FFF9C80E" android:pathData="M106,96 L107,100 L111,101 L107,102 L106,106 L105,102 L101,101 L105,100 Z" />
</vector>
