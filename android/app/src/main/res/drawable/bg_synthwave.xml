<?xml version="1.0" encoding="utf-8"?>
<!--
    Fundo synthwave: céu em gradiente, sol listrado no horizonte e grade neon em perspectiva.
    Desenho 100% vetorial (escala sem perder qualidade e não usa imagem externa).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="200dp"
    android:viewportWidth="360"
    android:viewportHeight="200">

    <!-- Céu: roxo-noite no topo até magenta no horizonte -->
    <path android:pathData="M0,0 H360 V130 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="0" android:endY="130">
                <item android:offset="0" android:color="#FF0D0221" />
                <item android:offset="0.6" android:color="#FF3A0B5E" />
                <item android:offset="1" android:color="#FFB0105F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sol: meio círculo com gradiente amarelo até magenta -->
    <path android:pathData="M115,130 A65,65 0 0,1 245,130 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="65"
                android:endX="0" android:endY="130">
                <item android:offset="0" android:color="#FFF9C80E" />
                <item android:offset="0.55" android:color="#FFFF6C11" />
                <item android:offset="1" android:color="#FFFF2A6D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Listras horizontais "cortando" o sol (marca registrada do synthwave) -->
    <!-- (trapézios recortados no formato do sol, para não vazar para o céu) -->
    <path android:fillColor="#FF2A0A4A" android:pathData="M122.3,100 L237.7,100 L239.1,103 L120.9,103 Z" />
    <path android:fillColor="#FF2A0A4A" android:pathData="M118.2,110 L241.8,110 L243,114 L117,114 Z" />
    <path android:fillColor="#FF2A0A4A" android:pathData="M115.9,119 L244.1,119 L244.7,124 L115.3,124 Z" />

    <!-- Chão -->
    <path android:fillColor="#FF0D0221" android:pathData="M0,130 H360 V200 H0 Z" />

    <!-- Grade: linhas horizontais (cada vez mais espaçadas = perspectiva) -->
    <path
        android:strokeColor="#9905D9E8"
        android:strokeWidth="1"
        android:pathData="M0,136 H360 M0,145 H360 M0,158 H360 M0,176 H360 M0,199 H360" />

    <!-- Grade: linhas que partem do ponto de fuga no centro do horizonte -->
    <path
        android:strokeColor="#9905D9E8"
        android:strokeWidth="1"
        android:pathData="M180,130 L-120,200 M180,130 L-30,200 M180,130 L60,200 M180,130 L130,200 M180,130 L180,200 M180,130 L230,200 M180,130 L300,200 M180,130 L390,200 M180,130 L480,200" />

    <!-- Linha do horizonte em magenta neon -->
    <path
        android:strokeColor="#FFFF2A6D"
        android:strokeWidth="2"
        android:pathData="M0,130 H360" />
</vector>
