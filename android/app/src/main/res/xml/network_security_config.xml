<?xml version="1.0" encoding="utf-8"?>
<!-- O Android bloqueia HTTP puro por padrão. Liberamos só os hosts locais da API. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>   <!-- emulador -> PC -->
        <domain includeSubdomains="false">localhost</domain>  <!-- celular físico com adb reverse -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
