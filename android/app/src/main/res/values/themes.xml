<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Tema global do app (aplicado no AndroidManifest) ===== -->
    <style name="Theme.SoundMatch" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/neon_magenta</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/neon_cyan</item>
        <item name="colorOnSecondary">@color/night_bg</item>
        <item name="colorSurface">@color/night_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/night_bg</item>
        <item name="android:windowBackground">@color/night_bg</item>
        <item name="android:statusBarColor">@color/night_bg</item>
        <item name="android:navigationBarColor">@color/night_bg</item>
        <!-- Cor de CheckBox, RadioButton, Switch e cursor do EditText -->
        <item name="colorAccent">@color/neon_cyan</item>
        <!-- No Android 15+ o app passa a desenhar por baixo da barra de status (edge-to-edge).
             Desligamos isso para o topo das telas não ficar escondido. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- ===== Título neon: fonte retrô Monoton + brilho (sombra colorida) ===== -->
    <style name="Widget.SoundMatch.NeonTitle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/monoton_regular</item>
        <item name="android:textSize">38sp</item>
        <item name="android:textColor">@color/title_glow_text</item>
        <item name="android:shadowColor">@color/neon_magenta</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">18</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Título menor das telas internas (mesma fonte, menos destaque) -->
    <style name="Widget.SoundMatch.ScreenTitle" parent="Widget.SoundMatch.NeonTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:shadowColor">@color/neon_cyan</item>
        <item name="android:shadowRadius">12</item>
    </style>

    <!-- Textos comuns (fonte padrão, para manter a leitura fácil) -->
    <style name="Widget.SoundMatch.Body" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.SoundMatch.Caption" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ===== Botões ===== -->
    <!-- Primário: preenchido em magenta -->
    <style name="Widget.SoundMatch.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- Secundário: só contorno ciano -->
    <style name="Widget.SoundMatch.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/neon_cyan</item>
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- Botões compactos dos itens do histórico -->
    <style name="Widget.SoundMatch.Button.Small" parent="Widget.SoundMatch.Button.Outlined">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Ação destrutiva (Excluir): só texto, em magenta -->
    <style name="Widget.SoundMatch.Button.Danger" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/neon_magenta</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ===== Campo de texto com contorno neon (TextInputLayout) ===== -->
    <style name="Widget.SoundMatch.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="hintTextColor">@color/neon_cyan</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <!-- ===== Opções do quiz ===== -->
    <style name="Widget.SoundMatch.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/neon_cyan</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.SoundMatch.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/neon_cyan</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Chip de escolha única (situação do perfil). O Chip do Material é uma subclasse de CheckBox -->
    <style name="Widget.SoundMatch.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Pergunta grande do perfil (uma por tela) -->
    <style name="Widget.SoundMatch.ProfileQuestion" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">28dp</item>
    </style>

    <!-- Botão redondo só com ícone (YouTube / Spotify): contorno neon, logo branco -->
    <style name="Widget.SoundMatch.Button.Icon" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/neon_cyan</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">32dp</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">28dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- Título de cada pergunta dentro do card -->
    <style name="Widget.SoundMatch.QuestionTitle" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- ===== Card com borda neon (MaterialCardView é uma subclasse de CardView) ===== -->
    <style name="Widget.SoundMatch.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/night_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/neon_cyan_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

</resources>
