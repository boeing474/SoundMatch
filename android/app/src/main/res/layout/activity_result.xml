<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".ui.ResultActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/Widget.SoundMatch.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/result_title" />

        <View style="@style/Widget.SoundMatch.HorizonLine" />

        <!-- Capa em destaque, com contorno na cor do perfil (pintado no Kotlin).
             Começa com o vinil e troca pela capa quando a busca no iTunes termina. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCover"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/night_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/neon_cyan"
            app:strokeWidth="3dp">

            <ImageView
                android:id="@+id/imgAlbumCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_album_cover"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_vinyl" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Superstition" />

        <TextView
            android:id="@+id/tvSongArtist"
            style="@style/Widget.SoundMatch.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="17sp"
            tools:text="Stevie Wonder" />

        <TextView
            android:id="@+id/tvAlbum"
            style="@style/Widget.SoundMatch.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Álbum: Talking Book"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpotify"
                style="@style/Widget.SoundMatch.Button.Icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="20dp"
                android:contentDescription="@string/cd_spotify"
                app:icon="@drawable/ic_spotify" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnYoutube"
                style="@style/Widget.SoundMatch.Button.Icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/cd_youtube"
                app:icon="@drawable/ic_youtube" />
        </LinearLayout>

        <!-- Contorno e cabeçalho são pintados no Kotlin com a cor do perfil -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            style="@style/Widget.SoundMatch.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:contentPadding="0dp"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layoutGenreHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="@string/result_header_label"
                        android:textColor="@color/text_on_genre"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGenre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_on_genre"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Pop &amp; K-pop" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Com o Me surpreenda ligado, o % some e entra esta frase -->
                    <TextView
                        android:id="@+id/tvSurpriseTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_surprise_title"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutMatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMatch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textSize="48sp"
                            android:textStyle="bold"
                            tools:text="67" />

                        <TextView
                            style="@style/Widget.SoundMatch.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/result_match_suffix"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMatchHint"
                        style="@style/Widget.SoundMatch.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/result_match_hint"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvHighlight"
                        style="@style/Widget.SoundMatch.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="14sp"
                        tools:text="Refrões que grudam, produção caprichada e muita personalidade." />

                    <TextView
                        android:id="@+id/tvLikedGenres"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/neon_cyan"
                        android:textSize="13sp"
                        tools:text="Hard Rock, Funk/Alternative" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SoundMatch.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.SoundMatch.QuestionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/result_reason_label" />

                <TextView
                    android:id="@+id/tvReason"
                    style="@style/Widget.SoundMatch.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"
                    android:textSize="14sp"
                    tools:text="Pedro, como você ouve música na academia..." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.SoundMatch.QuestionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/result_rate_question" />

        <!-- Cada botão já salva a música com a avaliação. A ProgressBar aparece por cima enquanto salva. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLike"
                    style="@style/Widget.SoundMatch.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/btn_like" />

                <Button
                    android:id="@+id/btnDislike"
                    style="@style/Widget.SoundMatch.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/btn_dislike" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressSave"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:elevation="8dp"
                android:indeterminateTint="@color/neon_cyan"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSaved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/neon_cyan"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Salva em Minhas Descobertas como Curti"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnShare"
            style="@style/Widget.SoundMatch.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/btn_share" />
    </LinearLayout>
</ScrollView>
