<?xml version="1.0" encoding="utf-8"?>
<!-- Um artista parecido na 1ª pergunta do quiz. Os chips são criados no Kotlin
     (dependem do artista favorito); o vinil aparece enquanto a foto não chega.
     É um pouco menor que os chips do perfil para caberem dois por linha no celular. -->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.SoundMatch.Chip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textSize="14sp"
    app:chipEndPadding="8dp"
    app:chipIcon="@drawable/ic_vinyl"
    app:chipIconSize="28dp"
    app:chipIconVisible="true"
    app:chipMinHeight="40dp"
    app:chipStartPadding="6dp"
    app:textEndPadding="4dp"
    app:textStartPadding="6dp" />
