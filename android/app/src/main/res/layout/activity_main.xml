<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Céu, vinil e chão em camadas: o chão é desenhado por cima e esconde a metade de baixo
             do vinil, que parece nascer no horizonte. fitXY mantém o horizonte sempre a 65% da
             altura da imagem (130 de 200), então dá para posicionar o vinil com margem fixa. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="217dp"
                android:layout_gravity="bottom"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/synth_sky" />

            <!-- Horizonte: 33dp (topo da imagem) + 141dp (65% de 217) = 174dp. Vinil de 176dp: 174 - 88 = 86 -->
            <ImageView
                android:id="@+id/imgVinyl"
                android:layout_width="176dp"
                android:layout_height="176dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="86dp"
                android:contentDescription="@string/cd_vinyl"
                android:src="@drawable/ic_vinyl" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="217dp"
                android:layout_gravity="bottom"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/synth_ground" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- A Monoton é uma fonte larga: o autoSize diminui o texto em telas estreitas -->
            <TextView
                android:id="@+id/tvTitle"
                style="@style/Widget.SoundMatch.NeonTitle"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:rotation="-4"
                android:text="@string/main_title"
                app:autoSizeMaxTextSize="36sp"
                app:autoSizeMinTextSize="18sp"
                app:autoSizeTextType="uniform" />

            <TextView
                style="@style/Widget.SoundMatch.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/main_subtitle"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnDiscover"
                style="@style/Widget.SoundMatch.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/btn_discover" />

            <Button
                android:id="@+id/btnHistory"
                style="@style/Widget.SoundMatch.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_history" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
