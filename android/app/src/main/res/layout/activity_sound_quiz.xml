<?xml version="1.0" encoding="utf-8"?>
<!-- Uma pergunta por vez: cada card é um passo e o Kotlin troca qual fica visível.
     Os botões ficam fixos embaixo, fora da área que rola. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.SoundQuizActivity">

    <ScrollView
        android:id="@+id/scrollQuiz"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Widget.SoundMatch.ScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/quiz_title" />

            <TextView
                android:id="@+id/tvProgress"
                style="@style/Widget.SoundMatch.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Pergunta 1 de 3" />

            <ProgressBar
                android:id="@+id/progressQuiz"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:progressBackgroundTint="@color/night_card"
                android:progressTint="@color/neon_magenta"
                tools:max="3"
                tools:progress="1" />

            <!-- Artistas parecidos com o favorito (só quando o Deezer achou). Cards criados no Kotlin. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKnown"
                style="@style/Widget.SoundMatch.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SoundMatch.QuestionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/known_title" />

                    <TextView
                        android:id="@+id/tvKnownHint"
                        style="@style/Widget.SoundMatch.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        tools:text="@string/known_hint" />

                    <!-- Grade de 2 colunas; cada card vem de item_artist_card.xml -->
                    <GridLayout
                        android:id="@+id/gridArtists"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="-4dp"
                        android:layout_marginTop="8dp"
                        android:columnCount="2" />

                    <TextView
                        android:id="@+id/tvKnownCount"
                        style="@style/Widget.SoundMatch.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/neon_cyan"
                        android:textSize="13sp"
                        tools:text="@string/known_none" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- O clima: uma opção por item do enum Energy. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEnergy"
                style="@style/Widget.SoundMatch.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SoundMatch.QuestionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/energy_title" />

                    <RadioGroup
                        android:id="@+id/rgEnergy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hit ou pérola (só com artistas parecidos): uma opção por item do enum Popularity. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPopularity"
                style="@style/Widget.SoundMatch.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SoundMatch.QuestionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/popularity_title" />

                    <RadioGroup
                        android:id="@+id/rgPopularity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Outros estilos: só no quiz reserva, quando não há artistas parecidos. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStyles"
                style="@style/Widget.SoundMatch.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SoundMatch.QuestionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/styles_title" />

                    <CheckBox
                        android:id="@+id/cbPop"
                        style="@style/Widget.SoundMatch.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/style_pop" />

                    <CheckBox
                        android:id="@+id/cbRock"
                        style="@style/Widget.SoundMatch.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/style_rock" />

                    <CheckBox
                        android:id="@+id/cbHiphop"
                        style="@style/Widget.SoundMatch.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/style_hiphop" />

                    <CheckBox
                        android:id="@+id/cbElectronic"
                        style="@style/Widget.SoundMatch.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/style_electronic" />

                    <CheckBox
                        android:id="@+id/cbBrazilian"
                        style="@style/Widget.SoundMatch.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/style_brazilian" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quero me arriscar: aparece junto com a última pergunta -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRisk"
                style="@style/Widget.SoundMatch.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchRisk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/risk_label"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />

                    <TextView
                        android:id="@+id/tvRiskHint"
                        style="@style/Widget.SoundMatch.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        tools:text="@string/risk_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Aparece enquanto o app busca as músicas dos artistas parecidos -->
    <LinearLayout
        android:id="@+id/layoutSearching"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="@color/neon_cyan" />

        <TextView
            style="@style/Widget.SoundMatch.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/quiz_searching"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.SoundMatch.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/btn_back"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnNext"
            style="@style/Widget.SoundMatch.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/btn_next" />
    </LinearLayout>
</LinearLayout>
