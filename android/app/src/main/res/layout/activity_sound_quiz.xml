<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".ui.SoundQuizActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_synthwave" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                style="@style/Widget.SoundMatch.ScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/quiz_title" />

            <TextView
                style="@style/Widget.SoundMatch.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quiz_step" />

            <ProgressBar
                android:id="@+id/progressQuiz"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="20dp"
                android:max="3"
                android:progress="0"
                android:progressBackgroundTint="@color/night_card"
                android:progressTint="@color/neon_magenta" />

            <TextView
                android:id="@+id/tvProgress"
                style="@style/Widget.SoundMatch.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end"
                android:textSize="12sp"
                tools:text="0 de 3 respondidas" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SoundMatch.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvQuestion1"
                        style="@style/Widget.SoundMatch.QuestionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="@string/q1_title" />

                    <!-- Não mudar a ordem das opções: a posição de cada uma é o gênero do voto (ordem do enum Genre) -->
                    <RadioGroup
                        android:id="@+id/rgSongPick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q1_opt_0" />

                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q1_opt_1" />

                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q1_opt_2" />

                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q1_opt_3" />
                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q1_opt_4" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SoundMatch.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvQuestion2"
                        style="@style/Widget.SoundMatch.QuestionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="@string/q2_title" />

                    <RadioGroup
                        android:id="@+id/rgArtistPick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q2_opt_0" />

                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q2_opt_1" />

                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q2_opt_2" />

                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q2_opt_3" />
                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q2_opt_4" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SoundMatch.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvQuestion3"
                        style="@style/Widget.SoundMatch.QuestionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="@string/q3_title" />

                    <RadioGroup
                        android:id="@+id/rgAlbumPick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q3_opt_0" />

                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q3_opt_1" />

                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q3_opt_2" />

                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q3_opt_3" />
                        <RadioButton
                            style="@style/Widget.SoundMatch.RadioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/q3_opt_4" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SoundMatch.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SoundMatch.QuestionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/styles_title" />

                    <CheckBox
                        android:id="@+id/cbPop"
                        style="@style/Widget.SoundMatch.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/style_pop" />

                    <CheckBox
                        android:id="@+id/cbRock"
                        style="@style/Widget.SoundMatch.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/style_rock" />

                    <CheckBox
                        android:id="@+id/cbHiphop"
                        style="@style/Widget.SoundMatch.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/style_hiphop" />

                    <CheckBox
                        android:id="@+id/cbElectronic"
                        style="@style/Widget.SoundMatch.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/style_electronic" />

                    <CheckBox
                        android:id="@+id/cbBrazilian"
                        style="@style/Widget.SoundMatch.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/style_brazilian" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnSeeResult"
                style="@style/Widget.SoundMatch.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:enabled="false"
                android:text="@string/btn_see_result" />

            <TextView
                android:id="@+id/tvQuizHint"
                style="@style/Widget.SoundMatch.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/quiz_hint_answer_all" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
