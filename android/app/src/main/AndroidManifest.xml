<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Nossa API roda em HTTP (sem HTTPS); o network_security_config libera só os endereços locais -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SoundMatch">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.UserProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.SoundQuizActivity"
            android:exported="false"
            android:parentActivityName=".ui.UserProfileActivity" />

        <activity
            android:name=".ui.ResultActivity"
            android:exported="false"
            android:parentActivityName=".ui.SoundQuizActivity" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

    </application>

</manifest>
