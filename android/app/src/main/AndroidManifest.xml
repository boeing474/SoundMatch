<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissão para acessar a API REST pela rede -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        networkSecurityConfig: libera HTTP (sem HTTPS) apenas para os endereços
        locais da API (10.0.2.2 no emulador / localhost via adb reverse).
    -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SoundMatch">

        <!-- As 5 Activities serão registradas aqui nas próximas etapas. -->

    </application>

</manifest>
